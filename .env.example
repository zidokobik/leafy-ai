ENVIRONMENT=development  # or "production"

# Vercel AI Gateway API Key
AI_GATEWAY_API_KEY=

# See https://vercel.com/ai-gateway/models for available models.
# The model must have vision capabilities.
AI_MODEL=openai/gpt-5-nano

# Supabase project settings used by the FastAPI backend.
# Never expose SUPABASE_SECRET_KEY to the frontend or commit it to Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
