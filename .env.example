# Environment configuration for the Leafy application
# Any key with the prefix "VITE_" or "PUBLIC_" is exposed to the frontend.

# -----------------------------------------------------------------------------
# Shared application configuration
# -----------------------------------------------------------------------------

ENVIRONMENT=development # or "production"

# -----------------------------------------------------------------------------
# Vercel AI Gateway
# -----------------------------------------------------------------------------

AI_GATEWAY_API_KEY=

# See https://vercel.com/ai-gateway/models for available models.
# The model must have vision and tool-calling capabilities.
AI_MODEL=openai/gpt-5-nano

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never expose SUPABASE_SECRET_KEY to the frontend
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------

# Leave empty to keep using the built-in demo data.
# Use / to send same-origin /api/v1 requests through the Vite development proxy.
VITE_API_BASE_URL=/

# Optional request and live-monitoring timing overrides (milliseconds).
VITE_API_TIMEOUT_MS=8000
VITE_MONITORING_POLL_MS=5000
VITE_HISTORY_POLL_MS=1800000
