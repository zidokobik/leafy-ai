# Environment configuration for the Leafy application
# Any key with the prefix "VITE_" is exposed to the frontend.

# -----------------------------------------------------------------------------
# Shared application configuration
# -----------------------------------------------------------------------------

ENVIRONMENT=development # or "production"

# -----------------------------------------------------------------------------
# Vercel AI Gateway
# -----------------------------------------------------------------------------

AI_GATEWAY_API_KEY=

# See https://vercel.com/ai-gateway/models for available models.
# The model must have vision and tool-calling capabilities.
AI_MODEL=openai/gpt-5-nano

# -----------------------------------------------------------------------------
# Database configuration
# -----------------------------------------------------------------------------

DATABASE_URI=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Secret used to sign session JWTs. Generate with `openssl rand -hex 32`.
JWT_SECRET_KEY=

# The session cookie is Secure by default when ENVIRONMENT=production, which
# requires HTTPS: browsers silently drop Secure cookies sent over plain HTTP.
# Only set this to false if you are temporarily serving over HTTP (e.g. a VPS
# without a TLS certificate yet).
# SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Camera image sync
# -----------------------------------------------------------------------------

# An hourly job logs in to the tutor's Cognito app client, fetches the latest
# camera images and copies them into a public Supabase Storage bucket. The job
# is skipped while any of these are empty. Run it on demand with
# `uv run python -m backend.cli sync-cameras`.
STUDENT_CLIENT_ID=
STUDENT_USERNAME=
STUDENT_PASSWORD=

SUPABASE_URL=https://your-project-id.supabase.co
# Server-side only (Project Settings -> API keys -> secret / service_role).
# Never prefix it with VITE_.
SUPABASE_SERVICE_KEY=
CAMERA_BUCKET=images

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------

# Optional. Leave empty to send same-origin /api/v1 requests, which the Vite
# development proxy forwards to FastAPI. Set an absolute URL only when the
# frontend is served from a different origin than the API.
VITE_API_BASE_URL=

# Optional request and sensor polling timing overrides (milliseconds).
VITE_API_TIMEOUT_MS=8000
VITE_SENSOR_POLL_MS=30000
VITE_CAMERA_POLL_MS=300000
